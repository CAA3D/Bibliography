EISSN = {1865-0937},
ISBN = {978-3-031-61949-6; 978-3-031-61950-2},
Keywords = {Han Opera Art; Cultural Three Factors; Digital Experience; Information
   Visualization},
Research-Areas = {Computer Science},
Unique-ID = {WOS:001282215400024},
}

@article{ WOS:000710025600003,
Author = {Hu, Runhong and Wang, Chaohui and Zhang (Christina), Tingting and
   Nguyen, Thixuan and Shapoval, Valeriya and Zhai, Lingchen},
Title = {Applying augmented reality (AR) technologies in theatrical performances
   in theme parks: A transcendent experience perspective},
Journal = {TOURISM MANAGEMENT PERSPECTIVES},
Year = {2021},
Volume = {40},
Month = {OCT},
Abstract = {This study aims to investigate the attributes of AR theatrical
   performance in theme parks that impact a visitor's emotional experience
   and how it would do so. Data were obtained from tourists who had
   experienced AR theatrical performances at the Fantawild theme park in
   China. Drawing on a transcendent experience perspective, this study
   proposed and tested a theoretical model depicting the relationship
   between the perceived experiential quality of AR theatrical performance
   with five major dimensions-visual appeal, heightened enjoyment,
   education and curiosity, escapism, and focused immersion-as well as
   visitors' emotional responses (i.e., nostalgia, and emotional arousal)
   and feelings of belonging to the theme park, which were statistically
   analyzed via partial least squares structural equation modeling. The
   results showed that AR experiential quality exerted positive effects on
   visitors' nostalgia and emotional arousal, all of which triggered a
   feeling of belonging to the theme park.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
DOI = {10.1016/j.tmp.2021.100889},
EarlyAccessDate = {SEP 2021},
Article-Number = {100889},
ISSN = {2211-9736},
EISSN = {2211-9744},
Keywords = {Augmented reality (AR); Theatrical performance; Theme park; Transcendent
   experience; Nostalgia; Emotional arousal; Feeling of belonging},
Keywords-Plus = {TOURISTS EMOTIONAL EXPERIENCES; MEHRABIAN-RUSSELL MODEL;
   CULTURAL-HERITAGE; VIRTUAL-REALITY; BEHAVIORAL INTENTIONS; VICARIOUS
   NOSTALGIA; EMPIRICAL-EVIDENCE; SOCIAL NETWORKING; SATISFACTION; IMPACT},
