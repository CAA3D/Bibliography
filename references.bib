Keywords = {Digital Storytelling; Virtual Environments; Virtual Reality;
   Interaction; Education; Learning},
Keywords-Plus = {CULTURAL-HERITAGE},
Research-Areas = {Computer Science},
Unique-ID = {WOS:001336528300010},
}

@inproceedings{ WOS:001282215400024,
Author = {Huang, Xinyi and Xu, Jie},
Editor = {Stephanidis, C and Antona, M and Ntoa, S and Salvendy, G},
Title = {Han Opera Interactive Exhibition and App Design Based on the Theory of
   Cultural Three Factors},
Booktitle = {HCI INTERNATIONAL 2024 POSTERS, PT III, HCII 2024},
Series = {Communications in Computer and Information Science},
Year = {2024},
Volume = {2116},
Pages = {220-227},
Note = {26th International Conference on Human-Computer Interaction (HCII),
   Washington, DC, JUN 29-JUL 04, 2024},
Abstract = {As a colourful part of Chinese local opera, Han opera has made great
   contributions to the inheritance of Chinese traditional culture.
   However, with the social change and cultural transformation, Han Opera
   is facing difficulties in its inheritance and development. Many young
   people pay little attention to Han Opera and know less about its
   cultural content and spiritual connotation. In order to promote Han
   Opera as a precious cultural heritage and explore its deep cultural
   connotations, this study designs a series of interactive exhibition
   diagrams of Han Opera and its corresponding APP experience service based
   on the theory of three factors of culture, which condenses Han Opera's
   symbols, characteristics, and cultural contents into three levels
   according to the material, social organisation, and spiritual life. The
   APP contains interactive contents such as AR theatre model, culture,
   listening and watching theatre, etc. Users can explore the contents of
   interest in the exhibition in depth through the interactive service
   process of APP. It provides a novel way to enrich young people's
   understanding and immersive experience of Chinese opera.},
Publisher = {SPRINGER INTERNATIONAL PUBLISHING AG},
Address = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
Type = {Proceedings Paper},
