Keywords = {Multisensory; AR; Cultural Heritage; System Design},
Keywords-Plus = {AUGMENTED REALITY},
Research-Areas = {Computer Science},
Unique-ID = {WOS:000535129700002},
}

@article{ WOS:001125912100001,
Author = {Xu, Hui and Zhang, Yonghua and Zhang, Jiawan},
Title = {Frescoes restoration via virtual-real fusion: Method and practice},
Journal = {JOURNAL OF CULTURAL HERITAGE},
Year = {2024},
Volume = {66},
Pages = {68-75},
Month = {MAR-APR},
Abstract = {In the era of artificial intelligence, image-based virtual restoration
   of cultural relics is one of the methods used in the restoration of
   cultural relics. As the most informative representative of cultural
   heritage in the study of historical materials, murals occupy a
   significant position in archaeology and ancient culture. Currently, most
   of the existing virtual restoration of murals is limited to the
   restoration of image information for local damage. The scenes of murals
   have large spatial scales and complex semantic contents. In order to
   enhance the semantic relevance of the virtual restoration of murals and
   the immersion of a visual perception, this paper proposes a kind of
   mural virtual-real fusion restoration display method based on visual
   attention mechanism. Based on the case study on the immersive fusion
   restoration of Dunhuang grotto murals, the feasibility of regional mural
   image restoration and real space scene fusion restoration is verified. A
   new paradigm of mural heritage protection in the context of virtual-real
   fusion is realized. (c) 2023 The Authors. Published by Elsevier Masson
   SAS on behalf of Consiglio Nazionale delle Ricerche (CNR). This is an
   open access article under the CC BY-NC-ND license (
   http://creativecommons.org/licenses/by-nc-nd/4.0/ )},
Publisher = {ELSEVIER FRANCE-EDITIONS SCIENTIFIQUES MEDICALES ELSEVIER},
Address = {65 RUE CAMILLE DESMOULINS, CS50083, 92442 ISSY-LES-MOULINEAUX, FRANCE},
Type = {Article},
DOI = {10.1016/j.culher.2023.11.001},
EarlyAccessDate = {NOV 2023},
ISSN = {1296-2074},
EISSN = {1778-3674},
Keywords = {Mural virtual restoration; Saliency detection; Fusion of virtual and
   real scene},
Research-Areas = {Archaeology; Art; Chemistry; Geology; Materials Science; Spectroscopy},
Unique-ID = {WOS:001125912100001},
}

@inproceedings{ WOS:001297875600009,
Author = {Waidyaratne, Avishi and Noisri, Suebphong and Srisupakwong, Kunanont and
   Wijayasekara, S. K. and Ratchatakomtrakoon, Ratchaneekom and Bongsasilp,
   Bhadravama and Vanichchanunt, Pisit and Wuttisittikulkij, Lunchakom},
Book-Group-Author = {IEEE},
Title = {Wat Arun Metaverse: A Virtual Reality based Approach for Digitization,
   Education, and Exploration of Cultural Heritage},
Booktitle = {2024 21ST INTERNATIONAL CONFERENCE ON ELECTRICAL
   ENGINEERING/ELECTRONICS, COMPUTER, TELECOMMUNICATIONS AND INFORMATION
   TECHNOLOGY, ECTI-CON 2024},
Series = {International Conference on Electrical Engineering Electronics Computer
   Telecommunications and Information Technology ECTI-CON},
Year = {2024},
Note = {21st International Conference on Electrical Engineering/Electronics,
   Computer, Telecommunications and Information Technology (ECTI-CON), Khon
   Khan Univ, Sci Pk, Khon Kaen, THAILAND, MAY 27-30, 2024},
Abstract = {Wat Arun, or the ` Temple of Dawn,' is a wellknown Buddhist temple and a
   significant tourist destination in Thailand. The temple serves as a hub
   for research on Buddhist studies and rich Thai culture. Overcoming the
   limitations in traditional cultural preservation, and educational
   methods, this paper describes a transformative Virtual Reality (VR)
   based metaverse design to attract users to explore this historical
   landmark. The methodology involves advanced Three-Dimensional (3D)
   digitization techniques for 3D model optimization, and customization,
   and a gamified educational framework. Results show the preliminary stage
   of the overall process of 3D implementation on Wat Arun metaverse. This
   study contributes as a vital platform for educators, researchers, and
   enthusiasts seeking an authentic and interactive exploration of rich
   cultural heritages. By setting a precedent for immersive and engaging
   experiences in heritage exploration, this research extends the
   boundaries of how cultural sites can be understood, appreciated, and
   preserved in the digital era.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
DOI = {10.1109/ECTI-CON60892.2024.10594792},
ISSN = {2837-6463},
ISBN = {979-8-3503-8156-6; 979-8-3503-8155-9},
Keywords = {metaverse; virtual reality; cultural heritage; 3d digitization;
   gamification; education},
Research-Areas = {Computer Science; Engineering; Telecommunications},
Unique-ID = {WOS:001297875600009},
}

@article{ WOS:000804470600001,
Author = {Khorloo, Oyundolgor and Ulambayar, Erdenebat and Altantsetseg, Enkhbayar},
Title = {Virtual reconstruction of the ancient city of Karakorum},
Journal = {COMPUTER ANIMATION AND VIRTUAL WORLDS},
Year = {2022},
Volume = {33},
Number = {3-4},
Month = {JUN},
Abstract = {Ruins of ancient cities hold valuable information for historians and
   archeologists and it allows them to learn about the society and culture
   of these cities. This paper explores the first attempt to virtually
   rebuild the historic city of Karakorum based on ruins and archeological
   findings from the 13th century AD. Further, the analytical and practical
   methods used to discover its unique urban planning and architectural
   form by reconstructing the city using various resources from
   archeological documents to historical science documents are introduced.
   We explore a digitized version of Karakorum city in an immersive and
   embodied manner because of the latest technological advances in virtual
   reality, and this allows us to conserve and visualize its cultural
   heritage. The research objectives of this study are to (1) create a
   three-dimensional visual model of the Karakorum city as close as
   possible to its real counterpart, and (2) use a game engine as a
   development platform for integration and interactive visualization.},
