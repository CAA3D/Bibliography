ISBN = {978-3-319-40651-0; 978-3-319-40650-3},
Keywords = {Virtual reality; Teaching; Cultural Heritage; Immersive environments;
   Oculus Rift},
Keywords-Plus = {CULTURAL-HERITAGE; DESIGN},
Research-Areas = {Computer Science},
Unique-ID = {WOS:000389495700011},
}

@article{ WOS:001290246700002,
Author = {Buragohain, Dipima and Meng, Yahui and Deng, Chaoqun and Li, Qirui and
   Chaudhary, Sushank},
Title = {Digitalizing cultural heritage through metaverse applications:
   challenges, opportunities, and strategies},
Journal = {HERITAGE SCIENCE},
Year = {2024},
Volume = {12},
Number = {1},
Month = {AUG 13},
Abstract = {Preservation and accessibility of cultural heritage have become
   essential with the rapid advancements of globalization and modernization
   endeavors constantly threatening historical artifacts and sites across
   the world. The advent of the metaverse, with its immersive and
   interactive capabilities, presents a novel approach to safeguarding and
   promoting cultural heritage. The current study aims to explore the
   potential of metaverse applications in digitalizing cultural heritage,
   encompassing virtual reconstructions, educational outreach, global
   accessibility, and sustainability. It conducts a systematic literature
   review using PRISMA guidelines to collect, screen, and evaluate existing
   research enquiries into investigating current practices and technologies
   in the digitalization of heritage preservation. The study also conducts
   case study research to investigate the challenges and opportunities
   associated with the virtual preservation of tangible and intangible
   cultural assets, including issues of authenticity, representation, and
   sustainability. Furthermore, it evaluates the impact of metaverse
   applications on public engagement and cultural education. The findings
   provide valuable insights into developing innovative strategies for
   preserving cultural heritage in the digital age while highlighting best
   practices and guidelines for optimizing metaverse applications in
   cultural heritage preservation.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
DOI = {10.1186/s40494-024-01403-1},
Article-Number = {295},
ISSN = {2050-7445},
Keywords = {Cultural heritage; Metaverse; Digital heritage preservation; Virtual
   reconstruction; 3D modeling},
Research-Areas = {Arts \& Humanities - Other Topics; Chemistry; Materials Science;
   Spectroscopy},
Unique-ID = {WOS:001290246700002},
}

@article{ WOS:001262675500001,
Author = {Gao, Kai and Lee, Dong-Yeop},
Title = {Exploring the Effect of Youth Cultural Heritage Education Using the
   Metaverse Platform: A Case Study of `'Pingyao Ancient City''},
Journal = {IEEE ACCESS},
Year = {2024},
Volume = {12},
Pages = {89234-89247},
Abstract = {This study aimed to investigate the impact of employing a metaverse
   platform in youth cultural heritage education, with a specific focus on
   UNESCO's cultural heritage site, ``Pingyao Ancient City.{''} We utilized
   the ZEPETO metaverse platform to create educational materials, and
   conducted experiments involving 90 young students. The experiment was
   divided into three groups: PPT-based education, video-based education,
   and metaverse-based education. Each group received instruction about
   Pingyao Ancient City using distinct educational methodologies. Knowledge
   quizzes and questionnaire surveys were administered to evaluate five
   variables: learning motivation, effectiveness \& convenience, learning
   immersion, learning achievement, and learning satisfaction. The data
   were analyzed using SPSS 26.0, and group differences were confirmed
   through one-way ANOVA. The results of the study demonstrated that the
   metaverse-based educational approach yielded positive effects regarding
   learning motivation, learning immersion, learning achievement, and
   learning satisfaction. This approach provides an innovative method for
   cultural heritage education for young individuals.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article},
DOI = {10.1109/ACCESS.2024.3417256},
ISSN = {2169-3536},
Keywords = {Metaverse; metaverse platform; cultural heritage education; educational
   effects; one-way ANOVA},
Research-Areas = {Computer Science; Engineering; Telecommunications},
Unique-ID = {WOS:001262675500001},
}

@article{ WOS:000508378800006,
Author = {Han, Ping-Hsuan and Chen, Yang-Sheng and Liu, Iou-Shiuan and Jang,
   Yu-Ping and Tsai, Ling and Chang, Alvin and Hung, Yi-Ping},
Title = {A Compelling Virtual Tour of the Dunhuang Cave With an Immersive
   Head-Mounted Display},
Journal = {IEEE COMPUTER GRAPHICS AND APPLICATIONS},
Year = {2020},
Volume = {40},
Number = {1},
Pages = {40-54},
Month = {JAN-FEB},
Abstract = {The Dunhuang Caves are the home to the largest Buddhist art sites in the
   world and are listed as a UNESCO World Heritage Site. Over time, the
   murals have been damaged by both humans and nature. In this article, we
   present an immersive virtual reality system for exploring spatial
   cultural heritage, which utilizes the digitized data from the Dunhuang
   Research Academy to represent the virtual environment of the cave. In
   this system, the interaction techniques that allow users to flexibly
   experience any of the artifacts or displays contribute to their
   understanding of the cultural heritage. Additionally, we evaluated the
   system by conducting a user study to examine the extent of user
   acquaintance after the entire experience. Our result has shown what
   participants learn from the spatial context and augmented information in
   the VR. This can be used as design considerations for developing other
   spatial heritages.},
Publisher = {IEEE COMPUTER SOC},
Address = {10662 LOS VAQUEROS CIRCLE, PO BOX 3014, LOS ALAMITOS, CA 90720-1314 USA},
Type = {Article},
DOI = {10.1109/MCG.2019.2936753},
ISSN = {0272-1716},
EISSN = {1558-1756},
Keywords = {Cultural differences; Image restoration; Three-dimensional displays;
   Head-mounted displays; Navigation; Art; Image color analysis},
Research-Areas = {Computer Science},
Unique-ID = {WOS:000508378800006},
}

