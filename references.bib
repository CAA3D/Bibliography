@Article{WOS:001449140000001,
  author          = {Yang, Zhiqiang and Shin, Jaewook and Ren, Jing and Hu, Wangming and Wang, Gulong and Peng, Tao},
  journal         = {CULTURAL TRENDS},
  title           = {Multiple narratives in museum theme-based exhibitions: combining digital technology and tangible heritage},
  year            = {2025},
  issn            = {0954-8963},
  month           = {2025 MAR 15},
  abstract        = {Cultural heritage preservation in the digital age should seek to combine
   digital technologies with physical heritage in digitized archives to
   enhance the richness of thematic exhibition narratives. This approach
   aims to address the challenges posed to exhibition narratives by the
   remoteness of natural heritage sites and the loss of artefacts. This
   combination enables heritage organizations to provide rich and immersive
   exhibition experiences, while facilitating exploration and close
   interaction with collections around the world. The focus of this study
   is to explore how heritage museums in the digital age are constructing
   narrative plurality and integrity in thematic exhibitions, and to assess
   audience acceptance of a new type of visitor experience resulting from
   physical reproductions combined with digital exhibits. The results of
   this study will make a positive contribution to promoting the potential
   of digital technologies in the preservation and presentation of cultural
   heritage.},
  address         = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
  doi             = {10.1080/09548963.2025.2478385},
  earlyaccessdate = {MAR 2025},
