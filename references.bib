Keywords = {cross-media approach; Bronzes of Riace; ``Virtual Museum Net of Magna
   Graecia{''}; mobile devices; stereoscopy},
Research-Areas = {Computer Science},
Unique-ID = {WOS:000262361700034},
}

@InProceedings{WOS:001441661600020,
  author         = {Bitter, Jessica Laura and Spierling, Ulrike},
  booktitle      = {SERIOUS GAMES, JCSG 2024},
  title          = {Against Isolation in the Museum: Playful Co-presence with Immersive Augmented Reality},
  year           = {2025},
  address        = {GEWERBESTRASSE 11, CHAM, CH-6330, SWITZERLAND},
  editor         = {Plass, JL and Ochoa, X},
  note           = {10th Joint International Conference on Serious Games, New York City, NY, NOV 07-08, 2024},
  pages          = {281-297},
  publisher      = {SPRINGER INTERNATIONAL PUBLISHING AG},
  series         = {Lecture Notes in Computer Science},
  volume         = {15259},
  abstract       = {Immersive augmented reality with head-mounted displays is increasingly
   being researched for museums and cultural heritage sites. However, the
   isolating nature of the devices is at odds with the usual group sizes of
   visitors. This paper firstly provides a systematic literature review of
   the field of co-presence as a quality of experience in immersive AR.
   Based on these findings, a collaborative prototype is built using a
   research-through-design approach. We then report on a preliminary
   evaluation study (n = 20) to assess the effect of the prototype on
   communication between participants. We conclude that there are still few
   solutions for delivering collaborative and playful immersive AR
   experiences in museums, but early indications suggest that it is
   promising.},
