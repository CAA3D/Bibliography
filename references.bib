ISSN = {1546-4261},
EISSN = {1546-427X},
Keywords = {3D reconstruction; cultural heritage; immersive exploration; virtual
   city; virtual reality},
Research-Areas = {Computer Science},
Unique-ID = {WOS:000804470600001},
}

@article{ WOS:000256624600002,
